#!/bin/bash

{{ if lookPath "tmux" -}}
pushd ~/.tmux/plugins/tpm/bin
./clean_plugins
./install_plugins
./update_plugins all
popd
{{- end }}

{{ if lookPath "zsh" -}}
antibody bundle \
    <{{ joinPath .chezmoi.sourceDir "zsh_plugins.txt" | quote }} \
    >~/.config/zsh/plugins.zsh
{{- end }}

{{ if lookPath "fish" -}}
# fish_variables is removed by .chezmoiremove; rebuild tide's config in it.
fish -c '
if string match -q "3.*" $FISH_VERSION
    emit _tide_init_install
else
    tide configure --auto --style=Lean --prompt_colors="16 colors" \
        --show_time="24-hour format" --lean_prompt_height="Two lines" \
        --prompt_connection=Disconnected --prompt_spacing=Sparse \
        --icons="Few icons" --transient=No
end'
{{- end }}

{{- $vim := "" }}
{{- if lookPath "gvim" }}
{{- $vim = "gvim -v" }}
{{- else if lookPath "vim" }}
{{- $vim = "vim" }}
{{- end }}

{{ if $vim -}}
{{ $vim }} +PlugClean! +PlugUpdate +qa
~/.vim/plugged/fzf/install --all --xdg --no-update-rc --no-bash --no-fish
{{ end -}}
